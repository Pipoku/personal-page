---
import { profile, stats, siteConfig } from '../data/cv.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="top" class="hero">
  <canvas id="hero-canvas" class="hero__canvas" aria-hidden="true"></canvas>

  <span class="hero__spark hero__spark--1" aria-hidden="true"></span>
  <span class="hero__spark hero__spark--2" aria-hidden="true"></span>

  <div class="hero__ow" aria-hidden="true">
    <div class="hero__planet">
      <span class="hero__planet-body"></span>
      <span class="hero__planet-ring"></span>
      <span class="hero__planet-moon"></span>
    </div>
  </div>

  <div class="hero__campfire" aria-hidden="true">
    <svg viewBox="0 0 80 64" width="100%" height="100%" fill="none">
      <g class="hero__spark-p" aria-hidden="true">
        <circle cx="50" cy="8" r="1.8" fill="#ffd93d" />
        <circle cx="32" cy="12" r="1.5" fill="#ffa62b" />
      </g>
      <path d="M18 52 h 44" stroke="#7a5630" stroke-width="9" stroke-linecap="round" />
      <path d="M22 49 L 60 43" stroke="#6b4a28" stroke-width="7" stroke-linecap="round" />
      <path d="M58 49 L 22 43" stroke="#5c3f20" stroke-width="7" stroke-linecap="round" />
      <ellipse cx="40" cy="52" rx="24" ry="5" fill="#2e1d0e" />
      <path d="M40 46 C 16 36 22 14 40 4 C 58 14 64 36 40 46 Z" fill="#ff7a1a" />
      <path d="M40 44 C 26 38 30 22 40 14 C 50 22 54 38 40 44 Z" fill="#ffd93d" />
      <path d="M40 42 C 33 38 36 28 40 23 C 44 28 47 38 40 42 Z" fill="#fff3b0" />
      <g class="hero__marshmallow">
        <line x1="14" y1="50" x2="24" y2="22" stroke="#8a6a45" stroke-width="3.5" stroke-linecap="round" />
        <rect x="20" y="12" width="11" height="14" rx="3.5" fill="#f6efdd" />
        <path d="M20 14 Q 25.5 12 31 15 Q 30 20 25.5 21 Q 20 20 20 14 Z" fill="#e8c98f" opacity="0.9" />
      </g>
    </svg>
  </div>

  <div class="container hero__inner">
    <p class="hero__hello reveal" style="--d:.05s" data-i18n="hero.hello">Hi, I'm</p>
    <h1 class="hero__name reveal" data-fun-fx="hero" style="--d:.15s">
      Renzo
      <span class="hero__name-accent">Carletti</span>
    </h1>
    <p class="hero__role reveal" style="--d:.25s">
      <span class="hero__role-prefix">$ whoami —</span>
      <span id="role-rotator" class="hero__role-text" data-i18n-roles data-roles={JSON.stringify(profile.roles)}>Decoupled Drupal & React Engineer</span>
      <span class="hero__role-cursor" aria-hidden="true">▍</span>
    </p>
    <p class="hero__desc reveal" style="--d:.35s" data-i18n="hero.summary">{profile.summary}</p>

    <div class="hero__actions reveal" style="--d:.45s">
      <a
        class="btn btn--primary"
        href={siteConfig.booking || '#contact'}
        target={siteConfig.booking ? '_blank' : undefined}
        rel={siteConfig.booking ? 'noopener noreferrer' : undefined}
        data-i18n="hero.letstalk"
      >Let's talk</a>
      <a class="btn btn--ghost" href={base + 'cv.pdf'} data-i18n="hero.download" download>Download CV</a>
    </div>

    <div class="hero__socials reveal" style="--d:.55s">
      <span class="hero__bilingual" data-i18n="hero.bilingual">Bilingual · EN / ES</span>
      <span class="hero__open"><span class="hero__open-dot" aria-hidden="true"></span><span data-i18n="hero.open">Open to work</span></span>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
      <a href={profile.email} aria-label="Email">Email</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub</a>
    </div>
  </div>

  <div class="hero__stats container reveal" style="--d:.65s">
    {stats.map((s, i) => (
      <div class="glass hero__stat" style={`--i:${i}`}>
        <span class="hero__stat-value" data-count={s.value} data-suffix={s.suffix}>0{s.suffix}</span>
        <span class="hero__stat-label" data-i18n={`hero.stats.${s.id}`}>{s.label}</span>
      </div>
    ))}
  </div>

  <a class="hero__scroll" href="#about" aria-label="Scroll to about">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M19 12l-7 7-7-7" />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 8rem 4rem;
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .hero__hello {
    font-family: var(--font-mono);
    color: var(--accent-2);
    font-size: 1rem;
    margin-bottom: 0.6rem;
  }

  .hero__name {
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    background: linear-gradient(110deg, #fff 30%, color-mix(in srgb, var(--accent-1) 60%, #fff));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__name-accent {
    background: linear-gradient(110deg, var(--accent-1), var(--accent-3));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__role {
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.6vw, 1.35rem);
    color: var(--muted);
    min-height: 2.2em;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .hero__role-prefix {
    color: var(--accent-1);
  }

  .hero__role-cursor {
    color: var(--accent-2);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero__desc {
    margin-top: 1.2rem;
    max-width: 60ch;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .hero__actions {
    margin-top: 2.2rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__socials {
    margin-top: 2.4rem;
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .hero__open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.78rem;
    color: #7cf7b8;
    background: rgba(124, 247, 184, 0.08);
    border: 1px solid rgba(124, 247, 184, 0.25);
  }

  .hero__bilingual {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-2) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
  }

  .hero__open-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    animation: pulse 2.2s var(--ease) infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5); }
    50% { box-shadow: 0 0 0 6px rgba(74, 222, 128, 0); }
  }

  .hero__socials a {
    color: var(--muted);
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: 2px;
    transition: color 0.25s, border-color 0.25s;
  }

  .hero__socials a:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
  }

  .hero__stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 4.5rem;
  }

  .hero__stat {
    padding: 1.2rem 1.4rem;
    text-align: center;
  }

  .hero__stat-value {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 700;
    background: linear-gradient(120deg, var(--accent-2), var(--accent-1));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero__stat-label {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero__scroll {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    color: var(--muted);
    animation: bob 2s ease-in-out infinite;
    transition: color 0.25s;
  }

  .hero__scroll:hover {
    color: var(--accent-2);
  }

  .hero__spark {
    display: none;
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe9a8 0%, #ffd93d 45%, transparent 75%);
    z-index: 1;
    opacity: 0.75;
  }

  html[data-theme='fun'] .hero__ow {
    display: block !important;
  }

  html[data-theme='fun'] .hero__campfire {
    display: block !important;
  }

  html[data-theme='fun'] .hero__spark {
    display: block !important;
  }

  .hero__spark--1 {
    right: 22vw;
    bottom: 62vh;
    animation: spark-float 5s ease-in-out infinite;
  }

  .hero__spark--2 {
    right: 16vw;
    bottom: 45vh;
    animation: spark-float 6.5s ease-in-out 1.2s infinite;
  }

  @keyframes spark-float {
    0%, 100% { transform: translateY(0); opacity: 0.3; }
    50% { transform: translateY(-14px); opacity: 0.85; }
  }

  /* Timber Hearth-ish planet (Outer Wilds) */
  .hero__ow {
    display: none;
    position: absolute;
    right: clamp(1rem, 8vw, 7rem);
    top: 13vh;
    width: clamp(70px, 7vw, 92px);
    aspect-ratio: 1;
    z-index: 1;
  }

  html[data-theme='fun'] .hero__ow {
    display: block !important;
  }

  .hero__planet {
    position: relative;
    width: 100%;
    height: 100%;
    animation: planet-drift 9s ease-in-out infinite;
  }

  .hero__planet-body {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 30%, #9ad66f 0%, #3f8f4e 42%, #1e5a36 100%);
    box-shadow: 0 0 18px rgba(90, 200, 120, 0.28);
  }

  .hero__planet-ring {
    position: absolute;
    inset: 22% -14% 22% -14%;
    border-radius: 50%;
    border: 3px solid rgba(240, 220, 170, 0.8);
    transform: rotate(-24deg) scaleX(0.62);
  }

  .hero__planet-moon {
    position: absolute;
    top: 6%;
    right: 2%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #e8d9b0, #b58a4f 70%);
    animation: moon-orbit 14s linear infinite;
    transform-origin: -320% 320%;
  }

  @keyframes planet-drift {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-12px) rotate(2deg); }
  }

  @keyframes moon-orbit {
    to { transform: rotate(360deg); }
  }

  /* Campfire with roasting marshmallow (Outer Wilds vibes) */
  .hero__campfire {
    display: none;
    position: absolute;
    right: clamp(1rem, 11vw, 9rem);
    bottom: 15vh;
    width: clamp(52px, 6vw, 70px);
    aspect-ratio: 1;
    z-index: 1;
  }

  html[data-theme='fun'] .hero__campfire {
    display: block !important;
  }

  .hero__marshmallow {
    animation: roast 5s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: 50% 80%;
  }

  .hero__spark-p circle {
    animation: spark-rise 2.6s ease-out infinite;
    transform-box: fill-box;
  }

  .hero__spark-p circle:nth-child(2) {
    animation-delay: 1.3s;
  }

  @keyframes roast {
    0%, 100% { transform: rotate(-6deg); }
    50% { transform: rotate(6deg); }
  }

  @keyframes spark-rise {
    0% { transform: translateY(0); opacity: 0; }
    25% { opacity: 1; }
    100% { transform: translateY(-22px); opacity: 0; }
  }

  @media (max-width: 720px), (max-height: 720px) {
    .hero__spark,
    .hero__ow,
    .hero__campfire {
      display: none !important;
    }
  }

  @media (max-width: 1000px) {
    .hero__ow,
    .hero__campfire {
      display: none !important;
    }
  }

  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  @media (max-width: 820px) {
    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .hero__stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero__stats .hero__stat:nth-child(5) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let roles = JSON.parse(document.getElementById('role-rotator').dataset.roles);
  let roleIndex = 0;
  let roleChar = 0;
  let deleting = false;
  const el = document.getElementById('role-rotator');

  function type() {
    const current = roles[roleIndex];
    if (!deleting) {
      roleChar++;
      el.textContent = current.slice(0, roleChar);
      if (roleChar === current.length) {
        deleting = true;
        setTimeout(type, 2000);
        return;
      }
      setTimeout(type, 55 + Math.random() * 40);
    } else {
      roleChar--;
      el.textContent = current.slice(0, roleChar);
      if (roleChar === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        setTimeout(type, 400);
        return;
      }
      setTimeout(type, 30);
    }
  }

  function restartTyping() {
    roleIndex = 0;
    roleChar = 0;
    deleting = false;
    el.textContent = '';
    if (reducedMotion) {
      el.textContent = roles[0];
    } else {
      type();
    }
  }

  if (!reducedMotion) type();

  window.addEventListener('i18n:changed', () => {
    roles = JSON.parse(el.dataset.roles);
    restartTyping();
  });

  const counters = document.querySelectorAll('[data-count]');
  if (reducedMotion) {
    counters.forEach((c) => (c.textContent = c.dataset.count + c.dataset.suffix));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          io.unobserve(el);
          const target = parseInt(el.dataset.count, 10);
          const suffix = el.dataset.suffix;
          const dur = 1400;
          const start = performance.now();
          const tick = (now) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.5 }
    );
    counters.forEach((c) => io.observe(c));
  }

  if (!reducedMotion) {
    import('../scripts/hero-three.js').then((m) => m.initHeroCanvas('hero-canvas'));
  }
</script>
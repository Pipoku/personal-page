---
import { profile, stats } from '../data/cv.js';
---

<section id="top" class="hero">
  <canvas id="hero-canvas" class="hero__canvas" aria-hidden="true"></canvas>

  <div class="hero__mascot" aria-hidden="true">
    <svg viewBox="0 0 120 150" width="100%" height="100%" fill="none">
      <ellipse cx="60" cy="30" rx="46" ry="14" fill="#17141d" />
      <path d="M60 2 L97 42 Q78 48 60 44 Q42 48 23 42 Z" fill="#17141d" />
      <ellipse cx="60" cy="112" rx="34" ry="34" fill="#17141d" />
      <path d="M26 106 Q60 88 94 106 L90 134 Q60 148 30 134 Z" fill="#1d1a26" />
      <path d="M44 46 Q38 68 44 92" stroke="#3a3347" stroke-width="5" stroke-linecap="round" />
      <path d="M76 46 Q82 68 76 92" stroke="#3a3347" stroke-width="5" stroke-linecap="round" />
      <path d="M34 124 l14 10 M86 124 l-14 10" stroke="#15121b" stroke-width="6" stroke-linecap="round" />
      <circle cx="26" cy="20" r="4" fill="#8fce4e" />
      <ellipse class="hero__mascot-eye" cx="48" cy="100" rx="5.5" ry="7" fill="#ffd93d" />
      <ellipse class="hero__mascot-eye" cx="72" cy="100" rx="5.5" ry="7" fill="#ffd93d" />
    </svg>
  </div>

  <span class="hero__spark hero__spark--1" aria-hidden="true"></span>
  <span class="hero__spark hero__spark--2" aria-hidden="true"></span>

  <div class="container hero__inner">
    <p class="hero__hello reveal" style="--d:.05s" data-i18n="hero.hello">Hi, I'm</p>
    <h1 class="hero__name reveal" style="--d:.15s">
      Renzo
      <span class="hero__name-accent">Carletti</span>
    </h1>
    <p class="hero__role reveal" style="--d:.25s">
      <span class="hero__role-prefix">$ whoami —</span>
      <span id="role-rotator" class="hero__role-text" data-i18n-roles data-roles={JSON.stringify(profile.roles)}>Decoupled Drupal & React Engineer</span>
      <span class="hero__role-cursor" aria-hidden="true">▍</span>
    </p>
    <p class="hero__desc reveal" style="--d:.35s" data-i18n="hero.summary">{profile.summary}</p>

    <div class="hero__actions reveal" style="--d:.45s">
      <a class="btn btn--primary" href="#contact" data-i18n="hero.letstalk">Let's talk</a>
      <a class="btn btn--ghost" href="/cv.pdf" data-i18n="hero.download" download>Download CV</a>
    </div>

    <div class="hero__socials reveal" style="--d:.55s">
      <span class="hero__open"><span class="hero__open-dot" aria-hidden="true"></span><span data-i18n="hero.open">Open to work</span></span>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
      <a href={profile.email} aria-label="Email">Email</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub</a>
    </div>
  </div>

  <div class="hero__stats container reveal" style="--d:.65s">
    {stats.map((s, i) => (
      <div class="glass hero__stat" style={`--i:${i}`}>
        <span class="hero__stat-value" data-count={s.value} data-suffix={s.suffix}>0{s.suffix}</span>
        <span class="hero__stat-label" data-i18n={`hero.stats.${s.id}`}>{s.label}</span>
      </div>
    ))}
  </div>

  <a class="hero__scroll" href="#about" aria-label="Scroll to about">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M19 12l-7 7-7-7" />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 8rem 4rem;
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .hero__hello {
    font-family: var(--font-mono);
    color: var(--accent-2);
    font-size: 1rem;
    margin-bottom: 0.6rem;
  }

  .hero__name {
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    background: linear-gradient(110deg, #fff 30%, color-mix(in srgb, var(--accent-1) 60%, #fff));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__name-accent {
    background: linear-gradient(110deg, var(--accent-1), var(--accent-3));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__role {
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.6vw, 1.35rem);
    color: var(--muted);
    min-height: 2.2em;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .hero__role-prefix {
    color: var(--accent-1);
  }

  .hero__role-cursor {
    color: var(--accent-2);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero__desc {
    margin-top: 1.2rem;
    max-width: 60ch;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .hero__actions {
    margin-top: 2.2rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__socials {
    margin-top: 2.4rem;
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .hero__open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.78rem;
    color: #7cf7b8;
    background: rgba(124, 247, 184, 0.08);
    border: 1px solid rgba(124, 247, 184, 0.25);
  }

  .hero__open-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    animation: pulse 2.2s var(--ease) infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5); }
    50% { box-shadow: 0 0 0 6px rgba(74, 222, 128, 0); }
  }

  .hero__socials a {
    color: var(--muted);
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: 2px;
    transition: color 0.25s, border-color 0.25s;
  }

  .hero__socials a:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
  }

  .hero__stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 4.5rem;
  }

  .hero__stat {
    padding: 1.2rem 1.4rem;
    text-align: center;
  }

  .hero__stat-value {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 700;
    background: linear-gradient(120deg, var(--accent-2), var(--accent-1));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero__stat-label {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero__scroll {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    color: var(--muted);
    animation: bob 2s ease-in-out infinite;
    transition: color 0.25s;
  }

  .hero__scroll:hover {
    color: var(--accent-2);
  }

  /* Vivi-inspired black mage (fun theme only) */
  .hero__mascot {
    display: none;
    position: absolute;
    right: clamp(1rem, 6vw, 5rem);
    bottom: 34vh;
    width: clamp(88px, 9vw, 116px);
    z-index: 1;
    animation: mascot-bob 3.4s ease-in-out infinite;
    transform-origin: bottom center;
  }

  html[data-theme='fun'] .hero__mascot {
    display: block;
  }

  .hero__mascot-eye {
    animation: mascot-blink 6s infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes mascot-bob {
    0%, 100% { transform: translateY(0) rotate(-1.5deg); }
    50% { transform: translateY(-10px) rotate(1.5deg); }
  }

  @keyframes mascot-blink {
    0%, 90%, 100% { transform: scaleY(1); }
    93%, 96% { transform: scaleY(0.08); }
  }

  .hero__spark {
    display: none;
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe9a8 0%, #ffd93d 45%, transparent 75%);
    z-index: 1;
    opacity: 0.75;
  }

  html[data-theme='fun'] .hero__spark {
    display: block;
  }

  .hero__spark--1 {
    right: 22vw;
    bottom: 62vh;
    animation: spark-float 5s ease-in-out infinite;
  }

  .hero__spark--2 {
    right: 16vw;
    bottom: 45vh;
    animation: spark-float 6.5s ease-in-out 1.2s infinite;
  }

  @keyframes spark-float {
    0%, 100% { transform: translateY(0); opacity: 0.3; }
    50% { transform: translateY(-14px); opacity: 0.85; }
  }

  @media (max-width: 720px) {
    .hero__mascot,
    .hero__spark {
      display: none !important;
    }
  }

  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  @media (max-width: 820px) {
    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .hero__stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero__stats .hero__stat:nth-child(5) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let roles = JSON.parse(document.getElementById('role-rotator').dataset.roles);
  let roleIndex = 0;
  let roleChar = 0;
  let deleting = false;
  const el = document.getElementById('role-rotator');

  function type() {
    const current = roles[roleIndex];
    if (!deleting) {
      roleChar++;
      el.textContent = current.slice(0, roleChar);
      if (roleChar === current.length) {
        deleting = true;
        setTimeout(type, 2000);
        return;
      }
      setTimeout(type, 55 + Math.random() * 40);
    } else {
      roleChar--;
      el.textContent = current.slice(0, roleChar);
      if (roleChar === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        setTimeout(type, 400);
        return;
      }
      setTimeout(type, 30);
    }
  }

  function restartTyping() {
    roleIndex = 0;
    roleChar = 0;
    deleting = false;
    el.textContent = '';
    if (reducedMotion) {
      el.textContent = roles[0];
    } else {
      type();
    }
  }

  if (!reducedMotion) type();

  window.addEventListener('i18n:changed', () => {
    roles = JSON.parse(el.dataset.roles);
    restartTyping();
  });

  const counters = document.querySelectorAll('[data-count]');
  if (reducedMotion) {
    counters.forEach((c) => (c.textContent = c.dataset.count + c.dataset.suffix));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          io.unobserve(el);
          const target = parseInt(el.dataset.count, 10);
          const suffix = el.dataset.suffix;
          const dur = 1400;
          const start = performance.now();
          const tick = (now) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.5 }
    );
    counters.forEach((c) => io.observe(c));
  }

  if (!reducedMotion) {
    import('../scripts/hero-three.js').then((m) => m.initHeroCanvas('hero-canvas'));
  }
</script>
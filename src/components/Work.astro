---
import { projects } from '../data/cv.js';
---

<section id="work" class="container">
  <div class="section-head reveal">
    <span class="kicker" data-i18n="work.kicker">// selected work</span>
    <h2 data-i18n="work.title">Live projects</h2>
  </div>

  <div class="work__grid">
    {projects.map((p, i) => (
      <a
        class={`glass work__card${p.featured ? ' work__card--featured' : ''} reveal`}
        style={`--d:${i * 0.07}s`}
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="work__head">
          <div>
            <span class="work__role" data-i18n={`work.role.${p.role}`}>{p.role}</span>
            <h3 class="work__name" data-i18n={`work.${i}.name`}>{p.name}</h3>
            <p class="work__tagline" data-i18n={`work.${i}.tagline`}>{p.tagline}</p>
          </div>
          <span class="work__visit">
            <span data-i18n="work.visit">Visit site</span>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17L17 7M7 7h10v10" />
            </svg>
          </span>
        </div>
        <p class="work__desc" data-i18n={`work.${i}.desc`}>{p.desc}</p>
        <div class="work__foot">
          <div class="work__tags">
            {p.tech.map((tag) => (
              <span class="work__tag">{tag}</span>
            ))}
          </div>
          {p.metric && (
            <span class="work__metric" data-i18n={`work.${i}.metric`}>{p.metric}</span>
          )}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }

  .work__card {
    display: flex;
    flex-direction: column;
    padding: 1.8rem;
    transition: transform 0.3s var(--ease), border-color 0.3s, background 0.3s, box-shadow 0.3s;
  }

  .work__card:hover {
    transform: translateY(-4px);
    background: var(--glass-strong);
    box-shadow: 0 18px 48px -18px color-mix(in srgb, var(--accent-1) 45%, transparent);
  }

  .work__card--featured {
    position: relative;
    background:
      linear-gradient(var(--glass-strong), var(--glass-strong)) padding-box,
      linear-gradient(120deg, color-mix(in srgb, var(--accent-1) 60%, transparent), color-mix(in srgb, var(--accent-2) 60%, transparent)) border-box;
    border: 1px solid transparent;
  }

  .work__card--featured:hover {
    box-shadow: 0 20px 52px -18px color-mix(in srgb, var(--accent-3) 50%, transparent);
  }

  .work__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .work__role {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-2) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-2) 25%, transparent);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.8rem;
  }

  .work__name {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .work__tagline {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .work__visit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.25s, transform 0.25s var(--ease);
  }

  .work__visit svg {
    transition: transform 0.25s var(--ease);
  }

  .work__card:hover .work__visit {
    color: var(--accent-2);
  }

  .work__card:hover .work__visit svg {
    transform: translate(2px, -2px);
  }

  .work__desc {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.95rem;
    flex: 1;
  }

  .work__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1.4rem;
    flex-wrap: wrap;
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .work__tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    color: var(--muted);
    background: color-mix(in srgb, var(--accent-1) 8%, transparent);
  }

  .work__metric {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-3);
    background: color-mix(in srgb, var(--accent-3) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-3) 30%, transparent);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .work__grid {
      grid-template-columns: 1fr;
    }
  }
</style>